# 统一换行符，避免 Windows 提交把整个仓库变成 CRLF
* text=auto eol=lf

# 脚本必须可执行
*.sh   text eol=lf
mvnw   text eol=lf

# Windows 批处理保持 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制文件不做换行转换
*.jar  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
