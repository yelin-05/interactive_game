{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "tasks": [
    {
      "label": "mvn: 编译 JavaEE",
      "type": "shell",
      "command": "${workspaceFolder}\\mvnw.cmd",
      "args": ["-B", "-ntp", "-f", "javaee/pom.xml", "compile"],
      "problemMatcher": ["$javac"],
      "group": "build"
    },
    {
      "label": "mvn: 打包 WAR",
      "type": "shell",
      "command": "${workspaceFolder}\\mvnw.cmd",
      "args": ["-B", "-ntp", "-f", "javaee/pom.xml", "package"],
      "problemMatcher": ["$javac"],
      "group": "build"
    },
    {
      "label": "mvn: 跑 JavaEE 测试",
      "type": "shell",
      "command": "${workspaceFolder}\\mvnw.cmd",
      "args": ["-B", "-ntp", "-f", "javaee/pom.xml", "test"],
      "problemMatcher": ["$javac"],
      "group": { "kind": "test", "isDefault": true }
    }
  ]
}
