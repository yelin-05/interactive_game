{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "启动 · H2 演示档（推荐先跑这个）",
      "request": "launch",
      "mainClass": "com.example.minigame.MinigameApplication",
      "projectName": "moshi",
      "vmArgs": "-Dspring.profiles.active=h2",
      "console": "internalConsole"
    },
    {
      "type": "java",
      "name": "启动 · MySQL 正式档",
      "request": "launch",
      "mainClass": "com.example.minigame.MinigameApplication",
      "projectName": "moshi",
      "vmArgs": "-Dspring.profiles.active=mysql",
      "console": "internalConsole"
    },
    {
      "type": "java",
      "name": "启动 · H2 + 真实大模型档（先用 set LLM_API_KEY=你的Key 设环境变量）",
      "request": "launch",
      "mainClass": "com.example.minigame.MinigameApplication",
      "projectName": "moshi",
      "vmArgs": "-Dspring.profiles.active=h2 -Dapp.llm.mode=real",
      "env": {
        "LLM_API_KEY": "${env:LLM_API_KEY}"
      },
      "console": "internalConsole"
    }
  ]
}
