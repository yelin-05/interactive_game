<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>魔识 · JavaEE 8</display-name>

    <filter>
        <filter-name>encodingFilter</filter-name>
        <filter-class>com.example.moshi.web.filter.EncodingFilter</filter-class>
    </filter>
    <filter>
        <filter-name>securityHeadersFilter</filter-name>
        <filter-class>com.example.moshi.web.filter.SecurityHeadersFilter</filter-class>
    </filter>
    <filter>
        <filter-name>sessionValidationFilter</filter-name>
        <filter-class>com.example.moshi.web.filter.SessionValidationFilter</filter-class>
    </filter>
    <filter>
        <filter-name>csrfFilter</filter-name>
        <filter-class>com.example.moshi.web.filter.CsrfFilter</filter-class>
    </filter>
    <filter>
        <filter-name>authFilter</filter-name>
        <filter-class>com.example.moshi.web.filter.AuthFilter</filter-class>
    </filter>
    <filter>
        <filter-name>adminFilter</filter-name>
        <filter-class>com.example.moshi.web.filter.AdminFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>encodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>securityHeadersFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>sessionValidationFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>csrfFilter</filter-name>
        <url-pattern>/login</url-pattern>
        <url-pattern>/register</url-pattern>
        <url-pattern>/logout</url-pattern>
        <url-pattern>/quiz</url-pattern>
        <url-pattern>/tasks</url-pattern>
        <url-pattern>/assets</url-pattern>
        <url-pattern>/llm</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>authFilter</filter-name>
        <url-pattern>/profile</url-pattern>
        <url-pattern>/profile/*</url-pattern>
        <url-pattern>/tasks</url-pattern>
        <url-pattern>/assets</url-pattern>
        <url-pattern>/llm</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>adminFilter</filter-name>
        <url-pattern>/admin</url-pattern>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- 统一编码：过滤器里也会设置，这里是兜底 -->
    <request-character-encoding>UTF-8</request-character-encoding>
    <response-character-encoding>UTF-8</response-character-encoding>

    <session-config>
        <session-timeout>60</session-timeout>
    </session-config>

    <!--
      统一 JSP 与静态 include 片段的读取编码。
      没有这段时，Jasper 会按默认编码读 *.jspf 片段，页面里的中文会变成乱码，
      而 .jsp 主体因为写了 pageEncoding 反而正常 —— 这正是踩过的坑。
    -->
    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <page-encoding>UTF-8</page-encoding>
        </jsp-property-group>
        <jsp-property-group>
            <url-pattern>*.jspf</url-pattern>
            <page-encoding>UTF-8</page-encoding>
        </jsp-property-group>
    </jsp-config>

    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error-404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error-500.jsp</location>
    </error-page>
</web-app>
